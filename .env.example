# ============================================================
# Environment Configuration
# Copy this file to ".env" and replace the placeholder values.
# Never commit the ".env" file or any real credentials.
# ============================================================

# --- Online Mode ---
# Base URL of any OpenAI-compatible chat-completions endpoint
# that serves an open-weight model.
# Leave this value empty to use a local Ollama instance (offline mode).
LLM_BASE_URL=https://your-provider-endpoint/v1

# API key issued by your chosen provider.
LLM_API_KEY=your_api_key_here

# Identifier of the model to be used for requests.
LLM_MODEL=your_model_name_here

# --- Offline Mode ---
# These values are used only when LLM_BASE_URL is empty.

# Address of the local Ollama server.
OLLAMA_URL=http://localhost:11434

# Name of a model that has been pulled locally with Ollama.
OLLAMA_MODEL=your_local_model_name